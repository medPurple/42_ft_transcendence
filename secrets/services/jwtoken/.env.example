# Service: jwtoken
# Copier ce fichier en .env et remplir les valeurs avant de lancer make all

# Base de données PostgreSQL
jwtoken_db_username=jwtoken_db_user
jwtoken_db_name=jwtoken_db
jwtoken_db_password=CHANGE_ME_STRONG_PASSWORD

# Clé secrète Django — générer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_KEY
