# Copier ce fichier en .env.vps et remplir les valeurs avant le déploiement.
# .env.vps est gitignored — ne jamais committer les vraies valeurs.

# Domaine principal du VPS (sans https://)
DOMAIN=monsite.com

# URL du frontend Cloudflare Pages (ex: https://my-project.pages.dev)
# Laisser vide si le frontend est servi par nginx sur le VPS.
FRONTEND_ORIGIN=https://my-project.pages.dev

# Email pour Let's Encrypt (renouvellement automatique)
CERTBOT_EMAIL=admin@monsite.com

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_strong_password
