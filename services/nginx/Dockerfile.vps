# Lightweight nginx for VPS — uses the apt nginx package with ModSecurity as a
# pre-compiled module (libnginx-mod-http-modsecurity) instead of building from
# source.  Build RAM usage drops from ~2 GB to ~300 MB.
#
# WAF is still active via modsecurity.conf — only the compilation step is removed.

FROM debian:bookworm

RUN apt-get update -y && apt-get install -y \
    nginx \
    libnginx-mod-http-modsecurity \
    libmodsecurity3 \
    curl jq ca-certificates gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Enable ModSecurity module
RUN echo "load_module modules/ngx_http_modsecurity_module.so;" \
    > /tmp/modsec_load.conf && \
    cat /etc/nginx/nginx.conf >> /tmp/modsec_load.conf && \
    mv /tmp/modsec_load.conf /etc/nginx/nginx.conf

# ModSecurity config
COPY /conf/modsecurity.conf /etc/nginx/modsecurity.conf

# OWASP Core Rule Set
RUN apt-get update -y && apt-get install -y git && rm -rf /var/lib/apt/lists/* && \
    git clone --depth 1 https://github.com/coreruleset/coreruleset.git /etc/nginx/owasp-crs
COPY /conf/modsecurity-crs.conf /etc/nginx/owasp-crs/crs-setup.conf

# nginx virtual host config
COPY /conf/nginx.vps.conf /etc/nginx/conf.d/default.conf

# Frontend static files
COPY ./frontend/ /usr/share/nginx/html/

# Startup script (envsubst + nginx)
COPY /conf/start.vps.sh /tmp/start.sh
RUN chmod +x /tmp/start.sh

CMD ["/tmp/start.sh"]
