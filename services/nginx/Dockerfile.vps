# Image officielle OWASP ModSecurity + nginx pré-compilés
FROM owasp/modsecurity-crs:nginx

USER root

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    jq curl ca-certificates gettext-base \
    && rm -rf /var/lib/apt/lists/*

# nginx virtual host config (avec envsubst pour DOMAIN / FRONTEND_ORIGIN)
COPY /conf/nginx.vps.conf /etc/nginx/templates/default.conf.template

# Frontend static files
COPY ./frontend/ /usr/share/nginx/html/

# Startup script
COPY /conf/start.vps.sh /tmp/start.sh
RUN chmod +x /tmp/start.sh

CMD ["/tmp/start.sh"]
